{
  "name": "ai-hotmonitor",
  "version": "1.0.0",
  "description": "AI-powered hot topic monitoring tool for investors",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts < NUL",
    "dev:client": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "start": "tsx src/server/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/server/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx src/server/seed.ts"
  },
  "dependencies": {
    "@openrouter/sdk": "^1.2.4",
    "@prisma/client": "^5.22.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "got": "^15.1.0",
    "gsap": "^3.13.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.5.0",
    "recharts": "^2.15.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
