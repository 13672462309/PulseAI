generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/hotmonitor.db"
}

// ── 监控关键词 ──
model Keyword {
  id              Int      @id @default(autoincrement())
  keyword         String   @unique
  category        String   @default("custom")
  isActive        Boolean  @default(true)
  priority        Int      @default(0)
  growthThreshold Float    @default(0.15)
  searchQueries   String?  // JSON array of English search queries (cached, builtin map + LLM-generated)
  intentContext   String?  // AI 生成的关键词意图上下文（投资语境/关联方向）
  zhExpansionQueries String? // JSON array of Chinese expansion queries (domestic channels)
  deletedAt       DateTime? // 软删除标记：删除关键词时置位，同名重新添加时恢复
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  alerts          Alert[]
}

// ── 数据源 ──
model Source {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  name            String
  url             String
  accessType      String   @default("scrape")
  isActive        Boolean  @default(true)
  status          String   @default("ok")
  cooldownUntil   DateTime?
  lastFetchedAt   DateTime?
  fetchIntervalMs Int      @default(1800000)
  createdAt       DateTime @default(now())

  topics          Topic[]
  crawlLogs       CrawlLog[]
}

// ── 话题 ──
model Topic {
  id              Int      @id @default(autoincrement())
  title           String
  normalizedTitle String
  sourceId        Int
  sourceRank      Int?
  url             String?
  heatIndex       Float    @default(0)
  heatScore       Float?   // unbounded absolute heat: sqrt(weighted engagement)/2 with source anchors
  prevHeatScore   Float?   // FIRST observed heatScore (baseline, written once) — growth rate = (current − baseline) / baseline
  rawHeat         Float?
  growthRate      Float?
  velocityScore   Float?
  aiVerified      Int      @default(0)
  isRumor         Boolean? // derived from verify classification (rumor_unverified); null = not verified
  isActionable    Boolean? // AI: worth acting on (market attention / investment reference)
  verifyRetry     Boolean  @default(false) // verify 调用失败，待下轮重试
  aiSummary       String?
  aiCategory      String?
  tier            String?   // "burst" | "hot" | "rising" | null (not keyword-relevant)
  matchedKeyword  String?   // which keyword this topic matched
  matchReason     String?   // AI: short reason why this topic matches a keyword
  matchConfidence Float?    // AI: relevance confidence 0-1
  engagement      String?   // JSON: per-source engagement breakdown (views/comments/etc.)
  snippet         String?   // search-result snippet used by relevance judgement/eval
  searchQuery     String?   // the exact query that surfaced this topic
  isHidden        Boolean  @default(false) // 关键词被软删除时置 true，同名恢复时解除
  firstSeenAt     DateTime
  lastSeenAt      DateTime
  publishedAt     DateTime? // original publish time from the source (null when unknown)
  recommendScore  Float?    // comprehensive recommendation score (tier + velocity + heat + freshness)
  peakHeat        Float    @default(0)
  mentionCount    Int      @default(1)

  source          Source   @relation(fields: [sourceId], references: [id])
  history         TopicHistory[]
  alerts          Alert[]

  @@index([normalizedTitle])
  @@index([firstSeenAt])
  @@index([lastSeenAt])
  @@index([publishedAt])
  @@index([recommendScore])
  @@index([sourceId])
  @@index([velocityScore])
}

// ── 话题历史（时间序列） ──
model TopicHistory {
  id         Int      @id @default(autoincrement())
  topicId    Int
  heatIndex  Float
  heatScore  Float?   // absolute heat at this observation (trend chart uses this)
  sourceRank Int?
  growthRate Float?
  recordedAt DateTime @default(now())

  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, recordedAt])
}

// ── 告警 ──
model Alert {
  id        Int      @id @default(autoincrement())
  topicId   Int
  keywordId Int?
  alertType String
  severity  String   @default("info")
  message   String
  isRead    Boolean  @default(false)
  isSent    Boolean  @default(false)
  createdAt DateTime @default(now())

  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  keyword   Keyword? @relation(fields: [keywordId], references: [id])

  @@index([isRead, createdAt])
}

// ── 系统设置 ──
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// ── 爬取日志 ──
model CrawlLog {
  id           Int      @id @default(autoincrement())
  sourceId     Int
  status       String
  topicsFound  Int      @default(0)
  durationMs   Int?
  errorMessage String?
  createdAt    DateTime @default(now())

  source       Source   @relation(fields: [sourceId], references: [id])

  @@index([sourceId, createdAt])
}
